# Copy to ~/.config/agent-skills/claude-issue-agent/config.env
CLAUDE_ISSUE_AGENT_HOME=~/.local/state/agent-skills/claude-issue-agent
CLAUDE_ISSUE_CLI=claude
CLAUDE_PROJECTS_DIR=~/.claude/projects
CLAUDE_ISSUE_LABEL_PREFIX=claude
CLAUDE_ISSUE_BRANCH_PREFIX=claude/issue-
CLAUDE_ISSUE_DEFAULT_MODEL=claude-opus-5
CLAUDE_ISSUE_DEFAULT_EFFORT=high
CLAUDE_ISSUE_POLL_INTERVAL=60
CLAUDE_ISSUE_BUSY_INTERVAL=10
CLAUDE_ISSUE_HEARTBEAT_INTERVAL=10
CLAUDE_ISSUE_KNOWN_MODELS=fable-5 opus-5 opus-4-6 sonnet-5 haiku-4-5
CLAUDE_ISSUE_VALID_EFFORTS=low medium high xhigh max
